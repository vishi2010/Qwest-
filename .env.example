# Copy this file to .env and fill in your values
# Get DB password from: Supabase Dashboard > Project Settings > Database > Database Password

SUPABASE_DB_PASSWORD=your-database-password-here
DATABASE_URL=postgresql://postgres.xuupowvxiufwongxihbm:your-database-password-here@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Ollama — text quest generation (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3

# ─── Vision provider ─────────────────────────────────────────────────────────
# Pick one: ollama | openai | anthropic
#
#   ollama     – fully local, needs Ollama running with a vision model (e.g. llava)
#   openai     – GPT-4o-mini, paid, reliable
#   anthropic  – Claude (recommended), great at structured JSON output, paid
# ─────────────────────────────────────────────────────────────────────────────
VISION_PROVIDER=anthropic
VISION_MIN_CONFIDENCE=0.80

# Ollama vision (used only when VISION_PROVIDER=ollama)
OLLAMA_VISION_MODEL=llava

# OpenAI vision (used only when VISION_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4.1-mini

# Anthropic vision (used only when VISION_PROVIDER=anthropic)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514
